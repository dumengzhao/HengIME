+void RimeWithWeaselHandler::Initialize() {
+  m_disabled = _IsDeployerRunning();
+  if (m_disabled) {
+    return;
+  }
+
+  LOG(INFO) << "Initializing heng-core.";
+  std::string shared_dir = wtou8(WeaselSharedDataPath().wstring());
+  std::string user_dir = wtou8(WeaselUserDataPath().wstring());
+  if (heng_create(shared_dir.c_str(), user_dir.c_str()) != 0) {
+    const char* err = heng_last_error();
+    LOG(ERROR) << "heng_create failed: " << (err ? err : "(null)");
+    m_disabled = true;
+    return;
+  }
+
+  // v4：样式从 weasel.yaml 加载（style 段 + preset_color_schemes/配色方案），
+  // _FillFallbackStyle 先填兜底值，配置命中的键覆盖之。
+  // weasel.yaml 由 heng-core 在启动部署时编译进 staging（对齐官方 WeaselDeployer）。
+  _FillFallbackStyle(m_base_style);
+  heng_config_t config = heng_config_open("weasel");
+  if (config) {
+    if (m_ui) {
+      m_ui->style() = m_base_style;
+      _UpdateUIStyle(config, m_ui, true);
+      m_current_dark_mode = !!IsUserDarkMode();
+      if (m_current_dark_mode) {
+        const int BUF_SIZE = 255;
+        char buffer[BUF_SIZE + 1] = {0};
+        if (heng_config_get_string(config, "style/color_scheme_dark", buffer,
+                                   BUF_SIZE)) {
+          _UpdateUIStyleColor(config, m_ui->style(), buffer);
+        }
+      }
+      m_base_style = m_ui->style();
+    }
+    int global_ascii = 0;
+    if (heng_config_get_bool(config, "global_ascii", &global_ascii))
+      m_global_ascii_mode = !!global_ascii;
+    // app_options 段 → m_app_options（_ReadClientInfo/_LoadAppInlinePreeditSet 消费）
+    _LoadAppOptions(config, m_app_options);
+    // v6：core 内置自绘候选窗开关（weasel.yaml ui/builtin，默认关 = 宿主 weasel 面板）
+    int builtin_ui = 0;
+    if (heng_config_get_bool(config, "ui/builtin", &builtin_ui))
+      m_builtin_ui = !!builtin_ui;
+    heng_config_close(config);
+  }
+  m_last_schema_id.clear();
+}
+
+void RimeWithWeaselHandler::Finalize() {
+  m_active_session = 0;
+  m_disabled = true;
+  m_session_status_map.clear();
+  LOG(INFO) << "Finalizing heng-core.";
+  heng_destroy();
+}
