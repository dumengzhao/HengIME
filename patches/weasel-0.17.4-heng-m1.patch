+BOOL RimeWithWeaselHandler::ProcessKeyEvent(KeyEvent keyEvent,
+                                            WeaselSessionId ipc_id,
+                                            EatLine eat) {
+  DLOG(INFO) << "Process key event: keycode = " << keyEvent.keycode
+             << ", mask = " << keyEvent.mask << ", ipc_id = " << ipc_id;
+  if (m_disabled)
+    return FALSE;
+  heng_session_t session_id = to_session_id(ipc_id);
+  // v6 热路径合并接口（process_key 内含自绘候选窗键盘语义拦截：↓ 展开、
+  // 面板内导航等）。out_commit/out_ctx 传 NULL，commit/context 仍走 _Respond
+  // 统一取，行为与旧 heng_process_key 完全一致。
+  int handled =
+      heng_process_key_ex(session_id, keyEvent.keycode,
+                          expand_ibus_modifier(keyEvent.mask), NULL, NULL);
+  // vim_mode when keydown only
+  if (!handled && !(keyEvent.mask & ibus::Modifier::RELEASE_MASK)) {
+    bool isVimBackInCommandMode =
+        (keyEvent.keycode == ibus::Keycode::Escape) ||
+        ((keyEvent.mask & (1 << 2)) &&
+         (keyEvent.keycode == ibus::Keycode::XK_c ||
+          keyEvent.keycode == ibus::Keycode::XK_C ||
+          keyEvent.keycode == ibus::Keycode::XK_bracketleft));
+    if (isVimBackInCommandMode && heng_get_option(session_id, "vim_mode") > 0 &&
+        heng_get_option(session_id, "ascii_mode") == 0) {
+      heng_set_option(session_id, "ascii_mode", 1);
+    }
+  }
+  _Respond(ipc_id, eat);
+  _UpdateUI(ipc_id);
+  m_active_session = ipc_id;
+  return (BOOL)handled;
+}
