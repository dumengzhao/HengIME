+  bool inline_preedit = session_status.style.inline_preedit;
+  bool found = false;
+  if (!app_name.empty()) {
+    auto it = m_app_options.find(app_name);
+    if (it != m_app_options.end()) {
+      AppOptions& options(m_app_options[it->first]);
+      for (const auto& pair : options) {
+        if (pair.first == "inline_preedit") {
+          heng_set_option(session_id, pair.first.c_str(), pair.second ? 1 : 0);
+          session_status.style.inline_preedit = pair.second;
+          found = true;
+          break;
+        }
+      }
+    }
+  }
+  if (!found) {
+    // M1 范围简化：schema 特定样式暂不加载（需 schema_open 通道），回落 base 样式
