+BOOL RimeWithWeaselHandler::ProcessKeyEvent(KeyEvent keyEvent,
+                                            WeaselSessionId ipc_id,
+                                            EatLine eat) {
+  DLOG(INFO) << "Process key event: keycode = " << keyEvent.keycode
+             << ", mask = " << keyEvent.mask << ", ipc_id = " << ipc_id;
+  if (m_disabled)
+    return FALSE;
+  heng_session_t session_id = to_session_id(ipc_id);
+  // Shift ç‹¬æŒ‰æ£€æµ‹ï¼ˆæŒ‰ä¸‹â†’é‡Šæ”¾æ— å…¶å®ƒæŒ‰é”®ï¼Œä¸ Linux addon åŒæ¬¾é€»è¾‘ï¼‰ï¼š
+  // ascii_composer åœ¨ Shift release æ—¶åˆ‡æ¢ä¸­è‹±ï¼Œheng_process_key_ex è¿”å›å
+  // çŠ¶æ€å·²æ˜¯æ–°å€¼ï¼Œæ­¤å¤„ç›´æ¥æŸ¥è¯¢å¹¶å¼¹ç¬æ€æ°”æ³¡ï¼ˆcore è‡ªç»˜çª—åŒè¿›ç¨‹ï¼Œå¯ç›´è°ƒï¼‰ã€‚
+  // åŒé”®åŒ¹é…ï¼šL Shift down + R Shift release çš„äº¤æ›¿ä¸æ„æˆç‹¬æŒ‰
+  static KeyEvent prev_key{};
+  bool shift_alone = (keyEvent.keycode == ibus::Keycode::Shift_L ||
+                      keyEvent.keycode == ibus::Keycode::Shift_R) &&
+                     (keyEvent.mask & ibus::Modifier::RELEASE_MASK) &&
+                     prev_key.keycode == keyEvent.keycode &&
+                     !(prev_key.mask & ibus::Modifier::RELEASE_MASK);
+  prev_key = keyEvent;
+  // v6 çƒ­è·¯å¾„åˆå¹¶æ¥å£ï¼ˆprocess_key å†…å«è‡ªç»˜å€™é€‰çª—é”®ç›˜è¯­ä¹‰æ‹¦æˆªï¼šâ†“ å±•å¼€ã€
+  // é¢æ¿å†…å¯¼èˆªç­‰ï¼‰ã€‚out_commit/out_ctx ä¼  NULLï¼Œcommit/context ä»èµ° _Respond
+  // ç»Ÿä¸€å–ï¼Œè¡Œä¸ºä¸æ—§ heng_process_key å®Œå…¨ä¸€è‡´ã€‚
+  int handled =
+      heng_process_key_ex(session_id, keyEvent.keycode,
+                          expand_ibus_modifier(keyEvent.mask), NULL, NULL);
+  // vim_mode when keydown only
+  if (!handled && !(keyEvent.mask & ibus::Modifier::RELEASE_MASK)) {
+    bool isVimBackInCommandMode =
+        (keyEvent.keycode == ibus::Keycode::Escape) ||
+        ((keyEvent.mask & (1 << 2)) &&
+         (keyEvent.keycode == ibus::Keycode::XK_c ||
+          keyEvent.keycode == ibus::Keycode::XK_C ||
+          keyEvent.keycode == ibus::Keycode::XK_bracketleft));
+    if (isVimBackInCommandMode && heng_get_option(session_id, "vim_mode") > 0 &&
+        heng_get_option(session_id, "ascii_mode") == 0) {
+      heng_set_option(session_id, "ascii_mode", 1);
+    }
+  }
+  _Respond(ipc_id, eat);
+  _UpdateUI(ipc_id);
+  // æ°”æ³¡å¿…é¡»åœ¨ _UpdateUI ä¹‹åå‘ï¼šShift åˆ‡æ¢æ¸…ç©ºç»„åˆä¸²ï¼Œ_UpdateUI èµ° Hideï¼Œ
+  // è‹¥å…ˆ hint å Hideï¼Œæ°”æ³¡åˆšå…¥é˜Ÿå°±è¢«è—çª—å‘½ä»¤ç§’æ€ï¼ˆUI çº¿ç¨‹æŒ‰åºæ¶ˆè´¹å‘½ä»¤ï¼‰ã€‚
+  // åæ ‡ç”¨ m_last_caret_*ï¼ˆUpdateInputPos æŒç»­ä¸ŠæŠ¥ï¼Œåˆ‡æ¢ç¬é—´ä¹Ÿå‡†ç¡®ï¼‰
+  if (shift_alone) {
+    HengStatus st;
+    if (heng_get_status(session_id, &st)) {
+      // ä»æœªè·å¾—è¿‡å…‰æ ‡ä½ç½®ï¼ˆè¿›ç¨‹å¯åŠ¨åæœªè¿›è¿‡ç¼–è¾‘æ¡†ï¼ŒUpdateInputPosition
+      // åªåœ¨æœ‰ç»„åˆä¸²æ—¶ä¸ŠæŠ¥ï¼‰â†’ ä¼  -1 è®© core èµ°å…œåº•é”šç‚¹ï¼Œé¿å…æ°”æ³¡é£åˆ° (0,0)
+      int hx = (m_last_caret_x || m_last_caret_y) ? (int)m_last_caret_x : -1;
+      heng_ui_mode_hint_ex(st.is_ascii_mode ? HENG_TRUE : HENG_FALSE, hx,
+                           (int)m_last_caret_y, (int)m_last_caret_top);
+      heng_free_status(&st);
+    }
+  }
+  m_active_session = ipc_id;
+  return (BOOL)handled;
+}
