+void RimeWithWeaselHandler::UpdateColorTheme(BOOL darkMode) {
+  // v4ï¼šæ ·å¼æ¢å¤ config é€šé“ï¼ˆäº®/æš—é…è‰²åˆ‡æ¢ï¼‰
+  heng_config_t config = heng_config_open("weasel");
+  if (config) {
+    if (m_ui) {
+      _UpdateUIStyle(config, m_ui, true);
+      m_current_dark_mode = !!darkMode;
+      if (darkMode) {
+        const int BUF_SIZE = 255;
+        char buffer[BUF_SIZE + 1] = {0};
+        if (heng_config_get_string(config, "style/color_scheme_dark", buffer,
+                                   BUF_SIZE)) {
+          _UpdateUIStyleColor(config, m_ui->style(), buffer);
+        }
+      }
+      m_base_style = m_ui->style();
+    }
+    heng_config_close(config);
+  }
+
+  for (auto& pair : m_session_status_map) {
+    HengStatus status;
+    if (heng_get_status(to_session_id(pair.first), &status)) {
+      pair.second.status.is_ascii_mode = !!status.is_ascii_mode;
+      pair.second.status.is_composing = !!status.is_composing;
+      pair.second.status.is_disabled = !!status.is_disabled;
+      pair.second.status.is_full_shape = !!status.is_full_shape;
+      pair.second.status.schema_id =
+          status.schema_id ? std::string(status.schema_id) : std::string();
+      pair.second.status.schema_name =
+          status.schema_name ? std::string(status.schema_name) : std::string();
+      pair.second.__synced = false;
+      heng_free_status(&status);
+    }
+    _LoadAppInlinePreeditSet(pair.first, true);
+    _UpdateInlinePreeditStatus(pair.first);
+  }
+  m_ui->style() = get_session_status(m_active_session).style;
+}
