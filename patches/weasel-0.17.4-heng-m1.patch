diff --git a/unlock-tsf.bat b/unlock-tsf.bat
new file mode 100644
index 0000000..a16f367
--- /dev/null
+++ b/unlock-tsf.bat
@@ -0,0 +1,74 @@
+@echo off
+rem ============================================================================
+rem unlock-tsf.bat - move the registered weaselx64.dll aside before relinking
+rem
+rem Why this exists:
+rem   weaselx64.dll is the TSF in-process server, loaded into every host that
+rem   activates the IME (explorer, notepad, any editor) and registered as an
+rem   InprocServer32 COM class. link.exe unlinks its output before writing it,
+rem   and DeleteFile fails on a file currently mapped as an image -> LNK1104.
+rem
+rem   Renaming works where deleting does not: the loaded hosts keep using the
+rem   renamed file's mapping and link.exe finds the name free. This mirrors what
+rem   build-core.bat does for heng_core.dll, which the running WeaselServer
+rem   locks the same way.
+rem
+rem   No admin rights needed. regsvr32 /u is not required either: the COM
+rem   registration stores a path, not a file identity, so a freshly linked dll
+rem   written back under the same name takes effect as-is.
+rem
+rem   Parked files carry a random suffix. A fixed name cannot be reused while
+rem   the previous occupant is still mapped, and it stays mapped for as long as
+rem   the hosts that loaded it keep running. Leftovers are swept here on every
+rem   run: del succeeds for the ones whose hosts have exited and fails for the
+rem   rest, which is exactly the desired behaviour.
+rem
+rem Usage:  unlock-tsf.bat <output-dir-name>      e.g. unlock-tsf.bat output-dev
+rem ============================================================================
+
+setlocal enabledelayedexpansion
+set WEASEL_ROOT=%~dp0
+set TARGET_DIR=%~1
+
+if "%TARGET_DIR%"=="" (
+  echo ERROR: usage: unlock-tsf.bat ^<output-dir-name^>
+  exit /b 1
+)
+
+set OUT=%WEASEL_ROOT%%TARGET_DIR%
+
+rem Park one file aside. Renaming works where deleting does not: hosts that
+rem already mapped it keep using the renamed file's mapping, and link.exe finds
+rem the name free. A fixed parked name cannot be reused while the previous
+rem occupant is still mapped, so it carries a random suffix. Leftovers are
+rem swept on every run: del succeeds for the ones whose hosts exited and fails
+rem for the rest, which is exactly the desired behaviour.
+call :park "%OUT%\weaselx64.dll" "weaselx64.dll"
+if errorlevel 1 endlocal & exit /b 1
+
+rem WeaselServer.exe is locked the same way, by the running service process.
+rem build-core.bat already stops that process before deploying the core dll,
+rem but TSF clients relaunch it as soon as an editor takes focus, so by the
+rem time msbuild gets here it may be back. Park it for the same reason.
+call :park "%OUT%\WeaselServer.exe" "WeaselServer.exe"
+if errorlevel 1 endlocal & exit /b 1
+
+call :park "%OUT%\WeaselDeployer.exe" "WeaselDeployer.exe"
+if errorlevel 1 endlocal & exit /b 1
+
+endlocal
+exit /b 0
+
+:park
+rem %1 = full path, %2 = display name
+if not exist "%~1" exit /b 0
+for %%F in ("%~1.parked*") do del /q "%%~fF" >nul 2>&1
+set PARK=%~1.parked!RANDOM!
+move "%~1" "!PARK!" >nul 2>&1
+if errorlevel 1 (
+  echo [unlock] cannot move %~2 aside - another process is writing it.
+  echo         Close the apps using the IME and retry.
+  exit /b 1
+)
+echo [unlock] parked %~2, path is free for relink
+exit /b 0
\ No newline at end of file
