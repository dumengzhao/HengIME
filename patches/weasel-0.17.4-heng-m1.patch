+
+static const UINT UI_COMMIT_POLL_INTERVAL_MS = 90;  // åŒ fcitx5 ä¾§ drain å‘¨æœŸ
+
+BOOL WeaselTSF::_StartUiCommitPoll() {
+  if (_hPollWnd)
+    return TRUE;
+  WNDCLASSW wc = {0};
+  wc.lpfnWndProc = _UiCommitPollWndProc;
+  wc.hInstance = GetModuleHandleW(NULL);
+  wc.lpszClassName = _hPollWndClass;
+  if (!RegisterClassW(&wc) && GetLastError() != ERROR_CLASS_ALREADY_EXISTS)
+    return FALSE;
+  _hPollWnd = CreateWindowExW(0, _hPollWndClass, L"", 0, 0, 0, 0, 0, HWND_MESSAGE, NULL,
+                              wc.hInstance, this);
+  if (!_hPollWnd)
+    return FALSE;
+  _uiCommitPollTimerId = SetTimer(_hPollWnd, 1, UI_COMMIT_POLL_INTERVAL_MS, NULL);
+  return _uiCommitPollTimerId != 0;
+}
+
+void WeaselTSF::_StopUiCommitPoll() {
+  if (_hPollWnd) {
