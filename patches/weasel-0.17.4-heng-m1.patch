+DWORD RimeWithWeaselHandler::FindSession(WeaselSessionId ipc_id) {
+  if (m_disabled)
+    return 0;
+  bool found = m_session_status_map.find(ipc_id) != m_session_status_map.end();
+  DLOG(INFO) << "Find session: ipc_id = " << ipc_id << ", found = " << found;
+  return found ? ipc_id : 0;
+}
+
+DWORD RimeWithWeaselHandler::AddSession(LPWSTR buffer, EatLine eat) {
+  if (m_disabled) {
+    DLOG(INFO) << "Trying to resume service.";
+    EndMaintenance();
+    if (m_disabled)
+      return 0;
+  }
+  heng_session_t session_id = heng_start_session(NULL);
+  if (session_id == 0) {
+    LOG(ERROR) << "heng_start_session failed";
+    return 0;
+  }
+  if (m_global_ascii_mode) {
+    for (const auto& pair : m_session_status_map) {
+      if (pair.first) {
+        heng_set_option(session_id, "ascii_mode",
+                        pair.second.status.is_ascii_mode ? 1 : 0);
+        break;
+      }
+    }
+  }
+
+  WeaselSessionId ipc_id =
+      _GenerateNewWeaselSessionId(m_session_status_map, m_pid);
+  DLOG(INFO) << "Add session: session_id = " << session_id
+             << ", ipc_id = " << ipc_id;
+  SessionStatus& session_status = new_session_status(ipc_id);
+  session_status.style = m_base_style;
+  session_status.session_id = session_id;
+  _ReadClientInfo(ipc_id, buffer);
+
+  HengStatus status;
+  if (heng_get_status(session_id, &status)) {
+    std::string schema_id =
+        status.schema_id ? std::string(status.schema_id) : std::string();
+    m_last_schema_id = schema_id;
+    session_status.status.is_ascii_mode = !!status.is_ascii_mode;
+    session_status.status.is_composing = !!status.is_composing;
+    session_status.status.is_disabled = !!status.is_disabled;
+    session_status.status.is_full_shape = !!status.is_full_shape;
+    session_status.status.schema_id = schema_id;
+    session_status.status.schema_name =
+        status.schema_name ? std::string(status.schema_name) : std::string();
+    session_status.__synced = false;
+    heng_free_status(&status);
+  }
+  _LoadAppInlinePreeditSet(ipc_id, true);
+  _UpdateInlinePreeditStatus(ipc_id);
+  m_ui->style() = session_status.style;
+  // show session's welcome message :-) if any
+  if (eat) {
+    _Respond(ipc_id, eat);
+  }
+  add_session = true;
+  _UpdateUI(ipc_id);
+  add_session = false;
+  m_active_session = ipc_id;
+  return ipc_id;
+}
+
+DWORD RimeWithWeaselHandler::RemoveSession(WeaselSessionId ipc_id) {
+  if (m_ui)
+    m_ui->Hide();
+  if (m_disabled)
+    return 0;
+  DLOG(INFO) << "Remove session: ipc_id = " << ipc_id;
+  // TODO: force committing? otherwise current composition would be lost
+  heng_end_session(to_session_id(ipc_id));
+  m_session_status_map.erase(ipc_id);
+  m_active_session = 0;
+  return 0;
+}
