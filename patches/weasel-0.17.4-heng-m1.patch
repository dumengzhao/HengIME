+  _InsertText(_pEditSessionContext, commit);
+  _EndComposition(_pEditSessionContext, false, !_status.composing);
+  _committed = TRUE;
+  if (!_status.composing && _IsComposing())
+    _EndComposition(_pEditSessionContext, true);
+}
