+  DLOG(INFO) << "Add session: session_id = " << session_id
+             << ", ipc_id = " << ipc_id;
+  SessionStatus& session_status = new_session_status(ipc_id);
+  session_status.style = m_base_style;
+  session_status.session_id = session_id;
+  _ReadClientInfo(ipc_id, buffer);
+
+  HengStatus status;
+  if (heng_get_status(session_id, &status)) {
+    std::string schema_id =
+        status.schema_id ? std::string(status.schema_id) : std::string();
+    m_last_schema_id = schema_id;
+    session_status.status.is_ascii_mode = !!status.is_ascii_mode;
+    session_status.status.is_composing = !!status.is_composing;
+    session_status.status.is_disabled = !!status.is_disabled;
+    session_status.status.is_full_shape = !!status.is_full_shape;
+    session_status.status.schema_id = schema_id;
+    session_status.status.schema_name =
+        status.schema_name ? std::string(status.schema_name) : std::string();
+    session_status.__synced = false;
+    heng_free_status(&status);
+  }
+  _LoadAppInlinePreeditSet(ipc_id, true);
+  _UpdateInlinePreeditStatus(ipc_id);
+  m_ui->style() = session_status.style;
+  // show session's welcome message :-) if any
+  if (eat) {
+    _Respond(ipc_id, eat);
+  }
+  add_session = true;
+  _UpdateUI(ipc_id);
+  add_session = false;
+  m_active_session = ipc_id;
+  return ipc_id;
+}
