+@echo off
+rem HengIME: build weasel x64 Release only (skip Win32/ARM: no 32-bit rime.lib)
+rem Props already rendered: weasel.props (BOOST_ROOT -> deps\boost_1_84_0, toolset v143)
+
+setlocal
+set WEASEL_ROOT=%~dp0
+cd /d %WEASEL_ROOT%
+
+call "C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\VC\Auxiliary\Build\vcvarsall.bat" x64
+if errorlevel 1 exit /b 1
+
+msbuild weasel.sln /t:Build /p:Configuration=Release /p:Platform=x64 /m /nodeReuse:false /v:m /nologo ^
+  /fl2 "/flp2:logfile=msbuild-x64.log;verbosity=normal"
+
+echo.
+echo ExitCode=%ERRORLEVEL%
+echo Log: %WEASEL_ROOT%msbuild-x64.log
+pause
