diff --git a/WeaselTSF/debuglog.h b/WeaselTSF/debuglog.h
new file mode 100644
index 0000000..a10e7c7
--- /dev/null
+++ b/WeaselTSF/debuglog.h
@@ -0,0 +1,22 @@
+#pragma once
+
+// M1 诊断日志（%TEMP%\heng-tsf.log）。Release 下 weasel LOG 宏为 no-op，此函数
+// 用于 TSF 端链路排查；M1 验证完成后可整体移除。
+inline void tsflog(const char* fmt, ...) {
+  char path[MAX_PATH];
+  GetTempPathA(MAX_PATH, path);
+  strcat_s(path, "heng-tsf.log");
+  FILE* f = NULL;
+  if (fopen_s(&f, path, "a") != 0 || !f)
+    return;
+  SYSTEMTIME st;
+  GetLocalTime(&st);
+  fprintf(f, "[%02d:%02d:%02d.%03d] ", st.wHour, st.wMinute, st.wSecond,
+          st.wMilliseconds);
+  va_list ap;
+  va_start(ap, fmt);
+  vfprintf(f, fmt, ap);
+  va_end(ap);
+  fputc('\n', f);
+  fclose(f);
+}
