+  BYTE retG = mix(fG, bG);
+  BYTE retB = mix(fB, bB);
+  BYTE outA = static_cast<BYTE>(retAlpha * 255.0f);
+  return (static_cast<COLORREF>(outA) << 24) | (retB << 16) | (retG << 8) |
