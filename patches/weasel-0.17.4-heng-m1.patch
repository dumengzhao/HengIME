+// ---- M1 诊断日志（%TEMP%\heng-server.log；Release 下 weasel LOG 宏为 no-op）----
+static void hlog(const char* fmt, ...) {
+  char path[MAX_PATH];
+  GetTempPathA(MAX_PATH, path);
+  strcat_s(path, "heng-server.log");
+  FILE* f = NULL;
+  if (fopen_s(&f, path, "a") != 0 || !f)
+    return;
+  SYSTEMTIME st;
+  GetLocalTime(&st);
+  fprintf(f, "[%02d:%02d:%02d.%03d] ", st.wHour, st.wMinute, st.wSecond,
+          st.wMilliseconds);
+  va_list ap;
+  va_start(ap, fmt);
+  vfprintf(f, fmt, ap);
+  va_end(ap);
+  fputc('\n', f);
+  fclose(f);
+}
