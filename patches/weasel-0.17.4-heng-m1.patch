index 0000000..b84a3a2
--- /dev/null
+++ b/build-core.bat
@@ -0,0 +1,92 @@
+@echo off
+rem ============================================================================
+rem build-core.bat - build heng_core.dll with cargo and deploy to weasel output
+rem
+rem Why this exists:
+rem   build-x64*.bat only invokes msbuild, which knows nothing about the Rust
+rem   workspace. The two toolchains never sync their outputs, so a rebuilt
+rem   heng_core.dll must be copied into the weasel output directories by hand.
+rem   Forgetting that step yields a WeaselServer.exe linked against the current
+rem   ABI but loading a stale core at run time: the service starts, the pipe
+rem   appears, the engine is reachable from heng-cli, yet TSF input never
+rem   reaches the editor. Static checks all pass, so the mismatch is invisible
+rem   until someone types.
+rem
+rem Usage:  build-core.bat <output-dir-name>     e.g. build-core.bat output-dev
+rem ============================================================================
+
+setlocal
+set WEASEL_ROOT=%~dp0
+set TARGET_DIR=%~1
+
+if "%TARGET_DIR%"=="" (
+  echo ERROR: usage: build-core.bat ^<output-dir-name^>
+  exit /b 1
+)
+
+rem weasel lives at <repo>\third_party\src\weasel, cargo workspace is <repo>
+set REPO_ROOT=%WEASEL_ROOT%..\..\..
+for %%I in ("%REPO_ROOT%") do set REPO_ROOT=%%~fI
+
+set CARGO=%USERPROFILE%\.cargo\bin\cargo.exe
+if not exist "%CARGO%" (
+  where cargo >nul 2>&1
+  if errorlevel 1 (
+    echo ERROR: cargo not found. Install Rust from https://rustup.rs/
+    exit /b 1
+  )
+  set CARGO=cargo
+)
+
+rem The server process holds heng_core.dll open while running, so a plain
+rem copy fails with "Access denied". Move the loaded file aside first; Windows
+rem refuses to rename a file that is currently mapped as an image.
+set DEPLOY_DIR=%WEASEL_ROOT%%TARGET_DIR%
+
+echo [core] building heng-core (release)...
+pushd "%REPO_ROOT%"
+"%CARGO%" build -p heng-core --release
+if errorlevel 1 (
+  popd
+  echo ERROR: cargo build failed.
+  exit /b 1
+)
+popd
+
+set BUILT=%REPO_ROOT%\target\release\heng_core.dll
+if not exist "%BUILT%" (
+  echo ERROR: %BUILT% not found after cargo build.
+  exit /b 1
+)
+
+if not exist "%DEPLOY_DIR%" (
+  echo ERROR: deploy dir %DEPLOY_DIR% does not exist.
+  exit /b 1
+)
+
+rem Stop any server still running from this output directory, otherwise the
+rem rename below fails. Other identities (dev vs release) keep running.
+rem TSF clients relaunch it as soon as an editor takes focus, so this only
+rem buys a moment â€” unlock-tsf.bat parks the exes before msbuild links.
+for /f "tokens=2 delims==" %%P in ('wmic process where "name='WeaselServer.exe'" get ExecutablePath^,ProcessId /format:csv 2^>nul ^| findstr /i "%DEPLOY_DIR%"') do (
+  echo [core] stopping WeaselServer running from %TARGET_DIR%...
+  taskkill /PID %%~P /F >nul 2>&1
+)
+
+rem Random suffix rather than a fixed .old name: the previous occupant stays
+rem mapped for as long as its host runs, and a fixed name cannot be reused
+rem while that is the case. Leftovers are swept each run â€” del succeeds for
+rem the ones already unmapped and fails for the rest.
+for %%F in ("%DEPLOY_DIR%\heng_core.dll.parked*") do del /q "%%~fF" >nul 2>&1
+if exist "%DEPLOY_DIR%\heng_core.dll" (
+  move "%DEPLOY_DIR%\heng_core.dll" "%DEPLOY_DIR%\heng_core.dll.parked%RANDOM%" >nul 2>&1
+)
+copy /y "%BUILT%" "%DEPLOY_DIR%\heng_core.dll" >nul
+if errorlevel 1 (
+  echo ERROR: failed to copy core dll into %DEPLOY_DIR%
+  exit /b 1
+)
+
+echo [core] deployed to %DEPLOY_DIR%\heng_core.dll
+for %%F in ("%DEPLOY_DIR%\heng_core.dll") do echo [core] size=%%~zF bytes
+endlocal
\ No newline at end of file
diff --git a/build-x64-dev.bat b/build-x64-dev.bat
new file mode 100644
index 0000000..e94e58d
--- /dev/null
+++ b/build-x64-dev.bat
@@ -0,0 +1,64 @@
+@echo off
+rem HengIME: build weasel x64 DEV identity, side-by-side with the release build.
+rem Differences from build-x64.bat:
+rem   1. CL=/DHENG_DEV - compile-time identity macro: dev GUID set (CLSID/Profile/
+rem      LangBar/DisplayAttr), IPC pipe name WeaselNamedPipeDev (both servers can
+rem      run at the same time), IME display name "HengDev".
+rem   2. Artifacts go to output-dev\ (does NOT touch the release output\ folder).
+rem   3. Intermediates go to msbuild-dev\Release\x64\<Project>\ (per-project
+rem      subdirectory, same layout as the release msbuild\ tree, so parallel
+rem      cl.exe processes never share one vc143.pdb - avoids error C1041).
+rem Register dev build (admin): regsvr32 third_party\src\weasel\output-dev\weaselx64.dll
+rem Unregister dev build (admin): regsvr32 /u with the same path.
+rem The release build is completely unaffected.
+
+setlocal
+set WEASEL_ROOT=%~dp0
+cd /d %WEASEL_ROOT%
+
+rem cl.exe appends the CL environment variable to its command line, so no
+rem vcxproj changes are needed for the HENG_DEV macro.
+set CL=/DHENG_DEV
+
+rem Build and deploy heng_core.dll before msbuild (goes to output-dev\).
+rem msbuild knows nothing about the cargo workspace, so the Rust core would
+rem otherwise stay at whatever version was last copied here by hand.
+call "%WEASEL_ROOT%build-core.bat" output-dev
+if errorlevel 1 exit /b 1
+
+call "C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\VC\Auxiliary\Build\vcvarsall.bat" x64
+if errorlevel 1 exit /b 1
+
+rem Free the weaselx64.dll output path. It is mapped into every host that
+rem activated the IME and registered as a COM inproc server, so link.exe would
+rem fail with LNK1104 when unlinking its own output.
+call "%WEASEL_ROOT%unlock-tsf.bat" output-dev
+if errorlevel 1 exit /b 1
+
+msbuild weasel.sln /t:Build /p:Configuration=Release /p:Platform=x64 /m /nodeReuse:false /v:m /nologo ^
+  "/p:OutDir=%WEASEL_ROOT%output-dev\\" "/p:HENG_INTDIR_SUFFIX=-dev" ^
+  /fl2 "/flp2:logfile=msbuild-x64-dev.log;verbosity=normal"
+
+rem External runtime dependencies (WinSparkle.dll, rime.dll, shared data\).
+rem Runs after msbuild so that clearing output-dev\ and rebuilding is enough to
+rem get a working tree, with no manual copy step.
+if errorlevel 1 (
+  echo.
+  echo ExitCode=%ERRORLEVEL%
+  echo Log: %WEASEL_ROOT%msbuild-x64-dev.log
+  pause
+  exit /b %ERRORLEVEL%
+)
+call "%WEASEL_ROOT%sync-deps.bat" output-dev
+if errorlevel 1 (
+  echo.
+  echo ExitCode=%ERRORLEVEL%
+  echo Log: %WEASEL_ROOT%msbuild-x64-dev.log
+  pause
+  exit /b 1
+)
+
+echo.
+echo ExitCode=0
+echo Log: %WEASEL_ROOT%msbuild-x64-dev.log
+pause
