+
+LRESULT CALLBACK WeaselTSF::_UiCommitPollWndProc(HWND hWnd,
+                                                 UINT uMsg,
+                                                 WPARAM wParam,
+                                                 LPARAM lParam) {
+  WeaselTSF* self = (WeaselTSF*)GetWindowLongPtrW(hWnd, GWLP_USERDATA);
+  if (uMsg == WM_TIMER && self) {
+    self->_PollUiCommit();
+    return 0;
+  }
+  if (uMsg == WM_NCCREATE) {
+    CREATESTRUCT* cs = (CREATESTRUCT*)lParam;
+    SetWindowLongPtrW(hWnd, GWLP_USERDATA, (LONG_PTR)cs->lpCreateParams);
+  }
+  return DefWindowProcW(hWnd, uMsg, wParam, lParam);
+}
+
+void WeaselTSF::_PollUiCommit() {
+  // æœªActivate / å·²Deactivate æ—¶æ— æœ‰æ•ˆTSF ä¸Šä¸‹æ–‡ï¼Œç›´æ¥è·³è¿‡ï¼ˆæ­¤æ—¶ä¹Ÿä¸è¯¥æœ‰commitï¼‰
