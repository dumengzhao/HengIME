diff --git a/sync-deps.bat b/sync-deps.bat
new file mode 100644
index 0000000..4c61868
--- /dev/null
+++ b/sync-deps.bat
@@ -0,0 +1,89 @@
+@echo off
+rem ============================================================================
+rem sync-deps.bat - populate external runtime dependencies in a weasel output dir
+rem
+rem Why this exists:
+rem   WeaselServer.exe imports WinSparkle.dll and heng_core.dll; heng_core.dll
+rem   in turn imports rime.dll. Missing any of them makes the service exit at
+rem   load time, before any log line is written. The shared data directory
+rem   (data\), holding the rime-ice dictionary, is required just as much. None
+rem   of these are msbuild outputs, so clearing output\ leaves the build
+rem   unusable until they are restored.
+rem
+rem   They live in third_party\externals\ so that output\ stays a pure build
+rem   artifact directory and a fresh machine has one documented place to
+rem   populate.
+rem
+rem Usage:  sync-deps.bat <output-dir-name>      e.g. sync-deps.bat output-dev
+rem ============================================================================
+
+setlocal
+set WEASEL_ROOT=%~dp0
+set TARGET_DIR=%~1
+
+if "%TARGET_DIR%"=="" (
+  echo ERROR: usage: sync-deps.bat ^<output-dir-name^>
+  exit /b 1
+)
+
+set REPO_ROOT=%WEASEL_ROOT%..\..\..
+for %%I in ("%REPO_ROOT%") do set REPO_ROOT=%%~fI
+
+set EXTERNALS=%REPO_ROOT%\third_party\externals
+set DEPLOY_DIR=%WEASEL_ROOT%%TARGET_DIR%
+
+if not exist "%DEPLOY_DIR%" (
+  echo ERROR: deploy dir %DEPLOY_DIR% does not exist.
+  exit /b 1
+)
+
+rem Pass 1: every source must be present, otherwise fail before touching the
+rem output dir. A half-populated output is worse than an untouched one.
+for %%F in (WinSparkle.dll rime.dll) do (
+  if not exist "%EXTERNALS%\%%F" (
+    echo ERROR: %EXTERNALS%\%%F is missing.
+    echo        See third_party\externals\README.md for where to obtain it.
+    exit /b 1
+  )
+)
+if not exist "%EXTERNALS%\data\cn_dicts" (
+  echo ERROR: %EXTERNALS%\data is missing or incomplete.
+  echo        See third_party\externals\README.md for where to obtain it.
+  exit /b 1
+)
+
+rem Pass 2: copy what the output dir lacks.
+rem rime.dll is the copy kept beside WinSparkle.dll rather than the librime
+rem dist one: the rime.lib that weasel links against and the rime.dll it loads
+rem at run time must come from one librime release, and keeping both in one
+rem directory makes that pairing visible.
+for %%F in (WinSparkle.dll rime.dll) do (
+  if exist "%DEPLOY_DIR%\%%F" (
+    echo [deps] %%F already present, skipped
+  ) else (
+    copy /y "%EXTERNALS%\%%F" "%DEPLOY_DIR%\%%F" >nul
+    if errorlevel 1 (
+      echo ERROR: failed to copy %%F into %DEPLOY_DIR%
+      exit /b 1
+    )
+    echo [deps] copied %%F to %DEPLOY_DIR%
+  )
+)
+
+rem Shared data dir, filled only when absent: it is 50MB and the engine also
+rem writes its deployed build\ output there at run time. Mirroring on every
+rem build would discard that and force a full redeploy.
+if exist "%DEPLOY_DIR%\data\cn_dicts" (
+  echo [deps] shared data already present, skipped
+) else (
+  echo [deps] copying shared data, about 50MB...
+  robocopy "%EXTERNALS%\data" "%DEPLOY_DIR%\data" /E /NFL /NDL /NJH /NJS /NP >nul
+  if errorlevel 8 (
+    echo ERROR: robocopy failed with code %ERRORLEVEL%
+    exit /b 1
+  )
+  echo [deps] shared data ready at %DEPLOY_DIR%\data
+)
+
+endlocal
+exit /b 0
\ No newline at end of file
