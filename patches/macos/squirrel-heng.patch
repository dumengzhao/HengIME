+    // 拿不到可靠屏幕坐标时，至少保证窗口不飞出屏幕。
+    // 注意夹紧必须在【点】域做，这里 rect 仍是点制。
+    if rect.minY < screen.frame.minY { rect.origin.y = screen.frame.minY }
+    if rect.minY > screen.frame.maxY - lineHForClamp {
