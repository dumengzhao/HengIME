# Agent 工作数据（会话记忆、工作区状态）
.workbuddy/

# 第三方预编译产物（按 third_party/README.md 手动获取，不进库；
# 目录整体忽略但保留 README —— 它们就是重建指南）
third_party/*
!third_party/README.md
!third_party/externals/
third_party/externals/*
!third_party/externals/README.md

# 本地运行时数据（RIME 用户目录、部署产物、日志）
runtime/
runtime-dev/

# Rust
target/
core/target/
**/*.rs.bk

# 试验目录（保留试验源码，只忽略编译产物；试验工程独立于根 workspace）
experiments/target/
experiments/*/target/

# Node
node_modules/
dist/
build/
*.log

# 各端构建产物
shells/android/.gradle/
shells/android/build/
shells/android/app/build/
shells/harmony/build/
shells/harmony/oh_modules/
shells/windows/x64/
shells/windows/Release/
shells/macos/build/
shells/linux/build/
# dev 隔离构建的 CMake 输出目录。conf-dev/ 是真实源码（dev-install.sh 直接
# cp 到 fcitx5 配置目录），不要一并忽略。
shells/linux/*/build-dev/

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
installation.yaml
user.yaml
